---
// RainfallTracker.astro
// Client-side only — all data fetching happens in the <script> block at runtime.
---

<div class="rt-wrap">
  <div class="rt-head">
    <span class="rt-title">2026 Monsoon Season</span>
    <span class="rt-sub">Season-to-date rainfall from 1 June · <span id="rt-source">Open-Meteo forecast API</span></span>
  </div>

  <div id="rt-body" class="rt-body">
    <div class="rt-loading">Fetching rainfall data&hellip;</div>
  </div>

  <div class="rt-foot">
    Last updated: <span id="rt-ts">--</span>
  </div>
</div>

<style>
  .rt-wrap {
    border: 1px solid var(--hairline);
    margin: 1.6em 0;
    font-size: 0.9rem;
    background: var(--paper);
  }

  .rt-head {
    background: var(--panel);
    border-bottom: 1px solid var(--hairline);
    padding: 9px 14px;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .rt-title {
    font-family: var(--serif);
    font-size: 1rem;
    color: var(--ink);
  }

  .rt-sub {
    font-size: 0.78rem;
    color: var(--ink-soft);
  }

  .rt-body {
    /* rows injected by JS */
  }

  .rt-loading,
  .rt-error {
    padding: 14px;
    color: var(--ink-soft);
    font-size: 0.85rem;
  }

  /* each city row */
  :global(.rt-row) {
    display: grid;
    grid-template-columns: 82px 1fr 72px;
    align-items: center;
    gap: 10px;
    padding: 9px 14px;
    border-bottom: 1px solid var(--hairline-soft);
  }

  :global(.rt-row:last-child) {
    border-bottom: none;
  }

  :global(.rt-city) {
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
  }

  :global(.rt-track) {
    height: 9px;
    background: var(--panel);
    border: 1px solid var(--hairline-soft);
    border-radius: 1px;
    overflow: hidden;
    min-width: 0;
  }

  :global(.rt-fill) {
    height: 100%;
    background: #4a8fc7;
    border-radius: 1px;
    transition: width 0.5s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.rt-fill) {
      transition: none;
    }
  }

  :global(.rt-mm) {
    text-align: right;
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--ink);
    white-space: nowrap;
  }

  :global(.rt-nodata) {
    color: var(--ink-soft);
    font-style: italic;
  }

  .rt-foot {
    background: var(--panel);
    border-top: 1px solid var(--hairline-soft);
    padding: 6px 14px;
    font-size: 0.76rem;
    color: var(--ink-soft);
  }

  /* ---- mobile: squeeze padding, allow city name to wrap */
  @media (max-width: 480px) {
    :global(.rt-row) {
      grid-template-columns: 76px 1fr 64px;
      gap: 8px;
      padding: 8px 10px;
    }

    .rt-head,
    .rt-foot {
      padding-left: 10px;
      padding-right: 10px;
    }
  }
</style>

<script>
  const CITIES = [
    { name: 'Mumbai',    lat: 19.0760, lon: 72.8777 },
    { name: 'Pune',      lat: 18.5204, lon: 73.8567 },
    { name: 'Delhi',     lat: 28.6139, lon: 77.2090 },
    { name: 'Bengaluru', lat: 12.9716, lon: 77.5946 },
    { name: 'Chennai',   lat: 13.0827, lon: 80.2707 },
  ] as const;

  // IST = UTC + 5h30m
  function nowIST(): Date {
    const now = new Date();
    return new Date(now.getTime() + (5.5 * 3600_000) - (now.getTimezoneOffset() * 60_000));
  }

  function seasonStart(): string {
    const ist = nowIST();
    const year = ist.getUTCFullYear();
    // If we're before June, back-date to previous year's season
    const month = ist.getUTCMonth(); // 0-indexed
    return month < 5 ? `${year - 1}-06-01` : `${year}-06-01`;
  }

  function todayIST(): string {
    const d = nowIST();
    const y = d.getUTCFullYear();
    const m = String(d.getUTCMonth() + 1).padStart(2, '0');
    const day = String(d.getUTCDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
  }

  function fmtTimestamp(d: Date): string {
    return d.toLocaleString('en-IN', {
      timeZone: 'Asia/Kolkata',
      day: 'numeric', month: 'short', year: 'numeric',
      hour: '2-digit', minute: '2-digit', hour12: false,
    }) + ' IST';
  }

  async function fetchCity(city: typeof CITIES[number]): Promise<number> {
    const url =
      `https://api.open-meteo.com/v1/forecast` +
      `?latitude=${city.lat}&longitude=${city.lon}` +
      `&daily=precipitation_sum` +
      `&start_date=${seasonStart()}&end_date=${todayIST()}` +
      `&timezone=Asia%2FKolkata`;
    const res = await fetch(url);
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const json = await res.json();
    const values: (number | null)[] = json.daily?.precipitation_sum ?? [];
    return Math.round(values.reduce((s, v) => s + (v ?? 0), 0));
  }

  type CityResult = { mm: number } | { error: true };

  function renderRows(results: Record<string, CityResult>): void {
    const body = document.getElementById('rt-body');
    if (!body) return;

    const maxMm = Math.max(
      0,
      ...Object.values(results).flatMap(r => ('mm' in r ? [r.mm] : []))
    );

    body.innerHTML = CITIES.map(city => {
      const r = results[city.name];
      if (!r || 'error' in r) {
        return `<div class="rt-row">
          <span class="rt-city">${city.name}</span>
          <div class="rt-track"></div>
          <span class="rt-mm rt-nodata">no data</span>
        </div>`;
      }
      const pct = maxMm > 0 ? Math.round((r.mm / maxMm) * 100) : 0;
      return `<div class="rt-row">
        <span class="rt-city">${city.name}</span>
        <div class="rt-track"><div class="rt-fill" style="width:${pct}%"></div></div>
        <span class="rt-mm">${r.mm} mm</span>
      </div>`;
    }).join('');

    const ts = document.getElementById('rt-ts');
    if (ts) ts.textContent = fmtTimestamp(new Date());
  }

  async function fetchAll(): Promise<void> {
    const results: Record<string, CityResult> = {};

    await Promise.all(
      CITIES.map(async city => {
        try {
          results[city.name] = { mm: await fetchCity(city) };
        } catch {
          results[city.name] = { error: true };
        }
      })
    );

    renderRows(results);
  }

  fetchAll();
  setInterval(fetchAll, 15 * 60 * 1000);
</script>
