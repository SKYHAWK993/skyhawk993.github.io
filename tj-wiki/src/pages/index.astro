---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base title="tj.wiki — Articles" description="Articles on data science, pricing, and whatever else I'm learning.">
  <h1>Articles</h1>
  <ul class="article-list">
    {
      posts.map((post) => (
        <li>
          <a class="entry-title" href={`/blog/${post.id}/`}>
            {post.data.title}
          </a>
          <div class="entry-meta">
            {fmt(post.data.date)}
            {post.data.tags.length > 0 && <> · {post.data.tags.join(', ')}</>}
          </div>
          {post.data.description && <p class="entry-desc">{post.data.description}</p>}
        </li>
      ))
    }
  </ul>
</Base>
